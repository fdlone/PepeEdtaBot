# Второй рубеж защиты плюс размер build-контекста.
#
# Первый рубеж — сам Dockerfile: он больше не делает `COPY . .`, а копирует
# только то, что нужно рантайму (main.py и app/). Поэтому забытая здесь строка
# уже не запекает данные в слой образа. Но контекст целиком уходит демону при
# каждой сборке, а на машине разработчика это десятки мегабайт БД и логов, —
# так что список ниже всё равно поддерживаем.
#
# Правило прежнее: всё, что не коммитится из-за чата или локального состояния,
# должно отсутствовать и здесь.

.git
.github
.idea
.venv
__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
*.pyc
*.pyo
*.pyd

# Secrets
.env

# Databases: the runtime one is bind-mounted in, never built in. `data/` is the
# default DB_PATH (see .env.example) and the compose mount point, so on a host
# that has run the bot it holds the chat corpus and the /pivo subscriptions.
data/
markov.db
markov.db-shm
markov.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
db_prod_copy/

# Logs: with GEN_TRACE_LOG=true these carry candidate texts, i.e. chat content.
*.log

# Local screenshots of the real chat (both the loose form and the folder).
Screenshot_*.jpg
scrin/

# Раунды ручной разметки мемов: список, ключ и ответы оценщиков — это
# дословные фразы приватного чата (docs/MEME_RATING_ROUND.md). В .gitignore
# они с самого начала, здесь строка была пропущена — то есть каталог уходил
# демону в контексте сборки, хотя правило файла требует обратного.
rating_rounds/

# Coverage: локальное состояние прогона, рантайму не нужно.
.coverage
.coverage.*
htmlcov/
coverage.xml

# IDE
.vscode/

# Local test scratch data
.test_tmp/
test_*.sqlite
test_*.sqlite-shm
test_*.sqlite-wal

# Not needed at runtime: dev tooling, tests, docs, specs, agent config.
# tools/ живёт только в тестах и ручных прогонах (eval, seed, sweeps), в app/
# и main.py оттуда нет ни одного импорта; в sweeps лежат ещё и прогоны на
# копии прода с реальным chat_id.
tests
tools
docs
openspec
.claude
AGENTS.md
CLAUDE.md
.mcp.json
skills-lock.json
README.md
LICENSE
.env.example
.gitattributes
pyproject.toml
requirements.txt
requirements-dev.txt
