# Python cache
__pycache__/
*.py[cod]
*$py.class

# Кэши инструментов. Сегодня они не попадают в `git status` и без этих строк:
# mypy и ruff кладут внутрь себя собственный `.gitignore` с `*`. Но это
# любезность инструментов, а не правило проекта — стоит одному перестать её
# оказывать, и в индекс поедут десятки мегабайт (.mypy_cache — 34 МБ).
# В .dockerignore они уже перечислены явно; здесь строки были пропущены.
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Virtual env
.venv/
venv/

# uv is a local runner only ([tool.uv] managed = false in pyproject.toml);
# pip + requirements files stay the source of truth for CI and Docker, so an
# accidentally generated lock must not be committed.
uv.lock

# Environment
.env

# SQLite
*.db
*.db-shm
*.db-wal
data/
db_prod_copy/
# Раунд ручной разметки мемов (docs/MEME_RATING_ROUND.md): список и ключ — это
# дословные фразы приватного чата, ответы оценщиков тоже. В отчёт идут только
# агрегаты.
rating_rounds/

# IDE
.vscode/
.idea/

# Logs
*.log

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# OS
.DS_Store
Thumbs.db

# Local screenshots of the real chat: both the loose form and the folder.
# Mirrors .dockerignore, where the folder was already excluded — here it was
# missing, so the directory was untracked only until the first `git add -A`.
Screenshot_*.jpg
scrin/

# Local agent instructions. AGENTS.md and CLAUDE.md are tracked: they carry the
# engineering rules and the tooling list, which belong to the project, not to
# one machine. Only per-machine settings stay ignored.
.claude/

# Local test temp data
.test_tmp/
test_*.sqlite
test_*.sqlite-shm
test_*.sqlite-wal

# Local MCP server configuration (may contain machine-specific settings)
.mcp.json

# Claude Code harness state, not project state
skills-lock.json

# Prod-metric eval reports embed a real chat_id and a db path — keep untracked.
# The tool itself (tools/eval_prod.py) is tracked: it takes --db/--chat-id as
# arguments and hardcodes nothing.
tools/eval_prod_baseline.json
