# Токен Telegram-бота из @BotFather
BOT_TOKEN=your_telegram_bot_token

# Секреты для /pivo: HMAC идентификаторов и шифрование данных упоминаний.
# Требования:
# - два разных значения;
# - минимум 16 символов, лучше 32+;
# - случайная строка без пробелов, например hex/base64/url-safe;
# - не менять после запуска, иначе старые /pivo-подписки станут недоступны;
# - не коммитить реальные значения в git.
#
# Пример формата, НЕ используйте эти значения в проде:
# PIVO_HMAC_SECRET=9f2b0d7e8c6a4b1f93e5d2c8a7b6f401
# PIVO_ENCRYPTION_SECRET=Zp6LxN4vQ8sT2mY7wR5kD9hF3cA1uE0
#
# Сгенерировать можно так:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
PIVO_HMAC_SECRET=change_me_to_a_long_random_hmac_secret
PIVO_ENCRYPTION_SECRET=change_me_to_a_long_random_encryption_secret

# Лимиты для /pivo:
# - число явных @mentions за один вызов;
# - максимальное число подписчиков, которых можно позвать без явных упоминаний.
PIVO_EXPLICIT_MENTIONS_LIMIT=10
PIVO_SUBSCRIBER_FANOUT_LIMIT=20

# Анти-повтор шаблонов /pivo (S2): сколько последних индексов top/body/bottom
# помнить на чат и исключать при следующем выборе. 0 отключает анти-повтор.
PIVO_RECENT_POOL_WINDOW=5

# Временны́е модификаторы /pivo (S4): вероятность (0..1) заменить нейтральную
# завершающую строку на тематическую (ночь / пятница / понедельник), когда
# соответствующее время применимо. 0 отключает временны́е вставки.
PIVO_TEMPORAL_FLAVOR_CHANCE=0.5

# Настроение чата (M1): скрытое per-chat состояние (sleepy/calm/lively/heated),
# вычисляемое из темпа сообщений, эмфатики (!/?/капс) и частоты обращений; оно
# плавно меняет поведение бота (вероятность ответа, вариативность, длину, flavor).
MOOD_ENABLED=true
# Дозирует весь эффект: 0 — настроение отслеживается, но ничего не меняет;
# 1 — встроенная таблица множителей; больше — усиливает.
MOOD_MODULATION_STRENGTH=1.0
# Сглаживание EWMA-сигналов настроения (больше — быстрее реагирует).
MOOD_EWMA_ALPHA=0.3
# Пороги темпа (сообщений/мин): sleepy < MOOD_SLEEPY < calm < MOOD_LIVELY < lively.
MOOD_LIVELY_RATE_PER_MIN=12.0
MOOD_SLEEPY_RATE_PER_MIN=2.0
# Сглаженная эмфатика, начиная с которой чат считается heated.
MOOD_HEATED_INTENSITY=0.4
# Ограничение мгновенного темпа, чтобы всплеск не разгонял EWMA.
MOOD_MAX_RATE_PER_MIN=120.0

# Директор вероятности ответа (M2): вместо фиксированного REPLY_PROBABILITY
# шанс самостоятельного ответа задаётся динамикой разговора (темп, обращения,
# ветки reply) и ложится в диапазон [MIN, MAX]. Выключение возвращает старое
# поведение — плоский REPLY_PROBABILITY (× множитель настроения).
REPLY_DIRECTOR_ENABLED=true
# Диапазон вероятности: тихий чат у нижней границы, живой/адресованный — у верхней.
# Прежний плоский REPLY_PROBABILITY (0.08) — примерно середина диапазона.
REPLY_PROBABILITY_MIN=0.02
REPLY_PROBABILITY_MAX=0.30
# Ритм всплеска: сразу после ответа шанс повышается на BOOST_SEC (бот втягивается
# в диалог), затем понижается на SUPPRESS_SEC (отходит). MIN_COOLDOWN_SEC остаётся
# жёстким нижним порогом.
REPLY_BURST_BOOST_SEC=180
REPLY_BURST_BOOST_MULT=2.0
REPLY_BURST_SUPPRESS_SEC=600
REPLY_BURST_SUPPRESS_MULT=0.5
# Предохранитель: не больше N самостоятельных ответов в час на чат (обращения
# всегда получают ответ и не считаются). 0 — без ограничения.
REPLY_MAX_PER_HOUR=20

# Runtime state cleanup for long-lived processes.
# Idle chat counters expire after RUNTIME_STATE_TTL_SEC.
# Command throttle entries expire after THROTTLE_STATE_TTL_SEC.
RUNTIME_STATE_TTL_SEC=86400
RUNTIME_STATE_MAX_CHATS=2048
THROTTLE_STATE_TTL_SEC=21600
THROTTLE_STATE_MAX_KEYS=4096

# Verbatim-copy cache holds the most recent normalized messages in memory.
# Generated text matching any of them exactly is discarded and retried.
TEXT_CACHE_MAX_MESSAGES=500

# SQLite stores only the most recent N normalized messages per chat.
# Must be greater than or equal to TEXT_CACHE_MAX_MESSAGES.
MESSAGES_RETENTION_PER_CHAT=1000

# SQLite write contention wait and automatic WAL checkpoint threshold.
# Set WAL autocheckpoint pages to 0 only if checkpoints are managed externally.
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000

# Базовый шанс ответа, если к боту не обращались напрямую (0..1)
REPLY_PROBABILITY=0.08

# Минимальная пауза между самостоятельными ответами в одном чате (сек)
MIN_COOLDOWN_SEC=45

# Минимальный объём модели, после которого разрешается генерация
MIN_TOKENS_FOR_MODEL=200

# Аварийный лимит длины сгенерированного сообщения в символах.
# Генератор не обрезает слова посередине, а останавливается на границе токена.
MAX_REPLY_CHARS=280

# Основной лимит длины сгенерированного сообщения в токенах
MAX_REPLY_TOKENS=45

# Telegram user id владельца с расширенными правами (команды также доступны админам чата)
OWNER_ID=

# Приводить все токены к нижнему регистру перед обучением/генерацией (true/false)
NORMALIZE_LOWER=false

# Капитализировать начало предложений в ответе (заглавная в начале и после . ! ?).
# Output-side постобработка, модель не затрагивается. Дефолт false: при
# NORMALIZE_LOWER=false стиль чата (вкл. намеренный lowercase) уже сохраняется;
# включайте только если ваш чат пишет формально и после offline-проверки
# (правило «после точки» капитализирует сокращения, напр. «т.е.»→«Т.Е.»).
AUTO_CAPITALIZE_REPLIES=false

# Путь к SQLite-базе
DB_PATH=data/markov.db

# Диапазон задержки перед ответом для эффекта «печатает...»
TYPING_MIN_MS=350
TYPING_MAX_MS=1100

# Добавка к задержке за каждый символ ответа (0..200), чтобы длинные ответы
# «печатались» дольше коротких. Общий потолок задержки — 4 секунды.
# 0 отключает компонент и возвращает старое поведение.
TYPING_PER_CHAR_MS=12

# Сила случайности генерации (0..3): чем больше, тем разнообразнее ответы
RANDOMNESS_STRENGTH=2.0

# Температура softmax-отбора финального кандидата (0..3).
# 0 — детерминированный argmax по скору (старое поведение); больше —
# чаще выигрывают «странные, но валидные» кандидаты в пределах допуска.
CANDIDATE_SELECTION_TEMPERATURE=0.7

# Сила вариатора формы ответа (0..2): вероятностные изменения финальной
# пунктуации (убрать точку / многоточие / "!" / удвоить "?!").
# 0 полностью отключает вариатор.
REPLY_FLAVOR_STRENGTH=1.0

# Сила штрафа за повторы в одном сгенерированном сообщении (0..3)
REPETITION_PENALTY_STRENGTH=1.0

# Сила штрафа за пересечение кандидата с недавно отправленными ответами (0..3).
# Точное совпадение с одним из последних 20 ответов отбрасывается всегда;
# частичное (триграммное) пересечение штрафуется пропорционально.
# 0 отключает триграммный штраф (точные совпадения всё равно отбрасываются).
RECENT_REPLY_PENALTY_STRENGTH=0.5

# Веса режимов целевой длины ответа: short(≤4),medium(5–14),long(15–24)
# контентных токенов. Режим выбирается на каждый ответ; пик оценки
# «естественной длины» сдвигается в диапазон выбранного режима, в short-режиме
# дополнительно ограничивается длина генерации.
LENGTH_MODE_WEIGHTS=0.25,0.55,0.2

# Основной порядок цепи Маркова: 2 или 3
MARKOV_ORDER=3

# Разрешить fallback на более низкий порядок, если нет перехода высокого порядка
ENABLE_BACKOFF=true

# Минимальный порядок fallback: 1 или 2 (должен быть < MARKOV_ORDER)
BACKOFF_MIN_ORDER=1

# Учитывать текст сообщения, на которое отвечают, как контекст для генерации
USE_REPLY_CONTEXT=true

# Разрешить case-insensitive поиск hidden-context state при отсутствии exact match.
# Включено по умолчанию: при NORMALIZE_LOWER=false модель хранит «Пиво» и «пиво»
# как разные состояния, и casefold-поиск заметно повышает долю контекстных
# стартов. Exact-путь всегда пробуется первым.
FUZZY_CONTEXT_CASEFOLD=true

# Разрешить консервативный prefix-поиск для кириллических hidden-context states.
# Независим от FUZZY_CONTEXT_CASEFOLD. Порядок: exact -> casefold -> prefix.
FUZZY_CONTEXT_PREFIX=false

# Максимум токенов, которые берутся из reply-контекста
REPLY_CONTEXT_MAX_TOKENS=12

# Сколько последних токенов контекста использовать как приоритетный старт (2 или 3)
REPLY_CONTEXT_LAST_TOKENS=3

# Насколько усиливать выбор токенов, связанных с reply-контекстом
REPLY_CONTEXT_BIAS=1.8

# Насколько усиливать выбор стартовой цепочки, найденной в reply-контексте
REPLY_CONTEXT_START_BIAS=2.2

# Применять контекст только для Telegram reply-сообщений
REPLY_CONTEXT_ONLY_FOR_REPLIES=true

# Добавлять токены текущего сообщения к reply-контексту
REPLY_CONTEXT_INCLUDE_CURRENT_MESSAGE=true

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Текстовые "прозвища", по которым бот считает себя упомянутым в обычном
# сообщении (без @username и без reply на бота). Через запятую,
# регистр не важен. Если переменная не задана или пустая —
# используются встроенные значения "pepe", "пепе".
# BOT_TEXT_ALIASES=pepe,пепе,пепка
