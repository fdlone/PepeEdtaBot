# ============================================================================
# PepeEdtaBot — пример конфигурации.
# Скопируйте в .env и заполните секцию «Деплой». Подробности по каждому слою —
# docs/GENERATION_PIPELINE.md; большинство ключей доступно на лету через /set.
# ============================================================================

# ----------------------------------------------------------------------------
# Деплой и идентичность
# ----------------------------------------------------------------------------

# Токен Telegram-бота из @BotFather
BOT_TOKEN=your_telegram_bot_token

# Telegram user id владельца с расширенными правами (команды также доступны
# админам чата)
OWNER_ID=

# Путь к SQLite-базе
DB_PATH=data/markov.db

# Текстовые «прозвища», по которым бот считает себя упомянутым в обычном
# сообщении (без @username и без reply на бота). Через запятую, регистр не
# важен. Если переменная не задана или пустая — используются встроенные
# значения "pepe", "пепе".
# BOT_TEXT_ALIASES=pepe,пепе,пепка

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Подробный трейс отбора кандидатов (логгер chat_markov.gen): каждый кандидат
# с текстом, очками и весами софтмакса. Инструмент отладки — на проде держать
# выключенным, иначе тексты чата попадают в логи на каждый ответ. Работает
# независимо от LOG_LEVEL (двусторонний гейт).
GEN_TRACE_LOG=false

# ----------------------------------------------------------------------------
# Когда бот отвечает
# ----------------------------------------------------------------------------

# Базовый шанс ответа, если к боту не обращались напрямую (0..1).
# Используется только при REPLY_DIRECTOR_ENABLED=false (× множитель настроения).
REPLY_PROBABILITY=0.08

# Минимальная пауза между самостоятельными ответами в одном чате (сек), 0..3600
MIN_COOLDOWN_SEC=45

# Анти-флуд для обращений к боту: прямое обращение (@бот / прозвище / reply)
# всегда обходит MIN_COOLDOWN_SEC и почасовой лимит, поэтому один пользователь
# мог бы вынуждать генерацию на каждое своё сообщение. Пауза (сек) между
# mention-ответами одному и тому же пользователю в одном чате; в паузе
# обращение обрабатывается как обычное сообщение. 0 отключает механизм.
MENTION_COOLDOWN_SEC=5

# Директор вероятности ответа (M2): вместо фиксированного REPLY_PROBABILITY
# шанс самостоятельного ответа задаётся динамикой разговора (темп, обращения,
# ветки reply) и ложится в диапазон [MIN, MAX]. Выключение возвращает старое
# поведение — плоский REPLY_PROBABILITY (× множитель настроения).
REPLY_DIRECTOR_ENABLED=true
# Диапазон вероятности: тихий чат у нижней границы, живой/адресованный — у
# верхней. Прежний плоский REPLY_PROBABILITY (0.08) — примерно середина.
REPLY_PROBABILITY_MIN=0.02
REPLY_PROBABILITY_MAX=0.30
# Ритм всплеска: сразу после ответа шанс повышается на BOOST_SEC (бот
# втягивается в диалог), затем понижается на SUPPRESS_SEC (отходит).
# MIN_COOLDOWN_SEC остаётся жёстким нижним порогом. Оба окна: 0..3600 сек.
REPLY_BURST_BOOST_SEC=180
REPLY_BURST_BOOST_MULT=2.0
REPLY_BURST_SUPPRESS_SEC=600
REPLY_BURST_SUPPRESS_MULT=0.5
# Предохранитель: не больше N самостоятельных ответов в час на чат (обращения
# всегда получают ответ и не считаются). 0 — без ограничения.
REPLY_MAX_PER_HOUR=20

# ----------------------------------------------------------------------------
# Настроение чата (M1)
# ----------------------------------------------------------------------------

# Скрытое per-chat состояние (sleepy/calm/lively/heated), вычисляемое из темпа
# сообщений, эмфатики (!/?/капс) и частоты обращений; плавно меняет поведение
# бота (вероятность ответа, вариативность, длину, flavor).
MOOD_ENABLED=true
# Дозирует весь эффект: 0 — настроение отслеживается, но ничего не меняет;
# 1 — встроенная таблица множителей; больше — усиливает.
MOOD_MODULATION_STRENGTH=1.0
# Сглаживание EWMA-сигналов настроения (больше — быстрее реагирует).
MOOD_EWMA_ALPHA=0.3
# Пороги темпа (сообщений/мин): sleepy < MOOD_SLEEPY < calm < MOOD_LIVELY < lively.
MOOD_LIVELY_RATE_PER_MIN=12.0
MOOD_SLEEPY_RATE_PER_MIN=2.0
# Сглаженная эмфатика, начиная с которой чат считается heated.
MOOD_HEATED_INTENSITY=0.4
# Эскалационные цепочки: сглаженная доля обращений к боту (mention_ewma), с
# которой чат читается как heated — серия прямых обращений «заводит» бота
# (растут randomness и flavor, длина смещается к коротким) даже при спокойном
# темпе и пунктуации. При alpha 0.3 три обращения подряд дают ~0.66, т.е. 0.6 ≈
# «три подряд». 0 — выключено (обращения питают только momentum директора M2).
# Дефолт 0.6 по реплею 1000 реальных сообщений 2026-07-16: ровно три подряд,
# «через одно» не поджигает, гаснет после первого чужого сообщения.
MOOD_MENTION_HEATED_SHARE=0.6
# Ограничение мгновенного темпа, чтобы всплеск не разгонял EWMA.
MOOD_MAX_RATE_PER_MIN=120.0

# ----------------------------------------------------------------------------
# Генерация текста
# ----------------------------------------------------------------------------

# Минимальный объём модели, после которого разрешается генерация, 0..1000000
MIN_TOKENS_FOR_MODEL=200

# Основной порядок цепи Маркова: 2 или 3
MARKOV_ORDER=3

# Разрешить fallback с 3-граммы на 2-грамму, если нет перехода высокого порядка
ENABLE_BACKOFF=true

# Дрейф темы (M4): вероятность на каждом шаге генерации (после 5 токенов,
# порядок 3) перепрыгнуть к новому выученному началу предложения, вставив
# связку («..., кстати ...»), чтобы смена темы читалась как ремарка. Не больше
# одного прыжка на ответ. 0 — выключено.
MARKOV_JUMP_PROBABILITY=0.12

# Контекст+хаос: множитель MARKOV_JUMP_PROBABILITY только для проходок,
# начатых с контекстного якоря (start_source context/hidden_context). Якорь
# озвучивает тему, буст обрывает пересказ корпуса, следующий за якорным окном.
# 1.0 — прыжки равновероятны везде (прежнее поведение).
CONTEXT_JUMP_BOOST=2.0

# Контекст+хаос: доля корпусных 4-грамм, с которой прошедший гейты кандидат
# считается «почти цитатой» и получает принудительную дописку (связка + свежий
# короткий прогон от глобального старта) — тот же механизм, что у полных копий.
# Дописка заменяет кандидата, только если комбинированный текст снова проходит
# гейты. 0 — выключено (дописываются только точные копии).
VERBATIM_EXTENSION_SHARE=0.8

# Сегментация якоря («прыжок наоборот»): доля видимых контекстных стартов, у
# которых якорь откладывается — проходка начинается с глобального старта, а
# эмиссия якоря вклеивается позже (связка + цепь продолжается из якорного
# состояния), так что контекст всплывает в середине или конце ответа, а не
# всегда открывает его. Делит бюджет «один прыжок на ответ» с MARKOV_JUMP_*:
# отложенный якорь подавляет глобальные прыжки и сам съедает слот. 0 —
# выключено (якорь всегда в начале). Дефолт 0.25 по A/B-замеру 2026-07-16:
# якорность 0.33→0.58 при умеренной связочной доле; выше 0.5 возвращается
# «тик связок».
CONTEXT_ANCHOR_SPLICE_PROBABILITY=0.25

# Клапан искусственного ветвления: вероятность на шаге генерации взять переход
# из более широкого order-2 пула, даже если order-3 продолжение есть (~98%
# order-3 состояний имеют ровно одно продолжение — проходка пересказывает
# исходное сообщение). Срабатывает только если order-2 реально шире и включён
# бэкофф. 0 — выключено (прежнее поведение).
ORDER_MIX_PROBABILITY=0.75

# Слот-мутации («отсебятина»): шанс на принятый кандидат выставить рядом его
# мутированную копию — одно контент-слово заменяется частотным словом чата.
# Гард согласования: часть речи + падеж/число/род/время (pymorphy3) поверх
# дешёвого префильтра по окончанию и длине; связки швов защищены. Копия
# конкурирует с оригиналом в скоринге (штраф за цитирование её поощряет).
# 0 — выключено (частотный словарь не читается, бросков нет).
SLOT_MUTATION_PROBABILITY=0.15

# Основной лимит длины сгенерированного сообщения в токенах
MAX_REPLY_TOKENS=45

# Аварийный лимит длины сгенерированного сообщения в символах.
# Генератор не обрезает слова посередине, а останавливается на границе токена.
MAX_REPLY_CHARS=280

# Приводить все токены к нижнему регистру перед обучением/генерацией (true/false).
# Дефолт true: иначе «Пиво» и «пиво» — разные состояния цепи, что дробит счётчики
# и тащит заглавные буквы в ответы. Миграция 015 разово приводит уже накопленную
# модель к нижнему регистру; при false она снова наберёт смешанный регистр.
NORMALIZE_LOWER=true

# Сила случайности генерации (0..3): чем больше, тем разнообразнее ответы
RANDOMNESS_STRENGTH=2.0

# Веса режимов целевой длины ответа: short(≤4),medium(5–14),long(15–24)
# контентных токенов. Режим выбирается на каждый ответ; пик оценки
# «естественной длины» сдвигается в диапазон выбранного режима, в short-режиме
# дополнительно ограничивается длина генерации.
LENGTH_MODE_WEIGHTS=0.25,0.55,0.2

# Интонационный профиль чата (P4): насколько веса длины выше и вероятности
# трансформаций концовки подстраиваются под фактическую манеру чата (доли
# коротких/средних/длинных сообщений и финальной пунктуации по окну ретенции
# messages). 0 — выключено (профиль не читается), 1.0 — распределения чата
# заменяют настроенные. Применяется только при ≥200 сообщениях в профиле.
INTONATION_PROFILE_STRENGTH=0

# Подстройка весов выше под длину сообщения, на которое отвечаем (0..3):
# короткая реплика (≤4 токенов) наклоняет выбор к short, длинная (≥14) — к long,
# между ними — линейно. Значение — сила наклона на краях: 1.0 удваивает вес
# long для длинного входящего и вдвое режет short. 0 = веса не трогаем.
LENGTH_CONTEXT_ADAPTATION=1.0

# ----------------------------------------------------------------------------
# Скоринг и отбор кандидатов
# ----------------------------------------------------------------------------

# Температура softmax-отбора финального кандидата (0..3).
# 0 — детерминированный argmax по скору; больше — чаще выигрывают «странные,
# но валидные» кандидаты в пределах допуска.
CANDIDATE_SELECTION_TEMPERATURE=0.7

# Сила штрафа за повторы в одном сгенерированном сообщении (0..3)
REPETITION_PENALTY_STRENGTH=1.0

# Сила штрафа за пересечение кандидата с недавно отправленными ответами (0..3).
# Точное совпадение с одним из последних 20 ответов отбрасывается всегда;
# частичное (триграммное) пересечение штрафуется пропорционально.
# 0 отключает триграммный штраф (точные совпадения всё равно отбрасываются).
RECENT_REPLY_PENALTY_STRENGTH=0.5

# Сила штрафа за пересказ обучающих сообщений (0..3). Кандидат-копия 1:1
# достраивается связкой и продолжением («отсебятина»), а штраф применяется
# только к почти-чистым цитатам: ниже доли корпусных 4-грамм 0.6 он нулевой.
VERBATIM_PENALTY_STRENGTH=1.5

# ----------------------------------------------------------------------------
# Reply-контекст (ответы «в тему»)
# ----------------------------------------------------------------------------

# Учитывать текст сообщения, на которое отвечают, как контекст для генерации
USE_REPLY_CONTEXT=true

# Разрешить case-insensitive поиск hidden-context state при отсутствии exact
# match. Включено по умолчанию: страхует чаты с NORMALIZE_LOWER=false, где
# модель хранит «Пиво» и «пиво» как разные состояния. Exact-путь всегда
# пробуется первым, так что на lowercase-модели поиск ничего не меняет.
FUZZY_CONTEXT_CASEFOLD=true

# Максимум токенов, которые берутся из reply-контекста
# Диапазон 2..300 — по масштабу MAX_REPLY_TOKENS.
REPLY_CONTEXT_MAX_TOKENS=12

# Насколько усиливать выбор токенов, связанных с reply-контекстом
REPLY_CONTEXT_BIAS=1.8

# Насколько усиливать выбор стартовой цепочки, найденной в reply-контексте
REPLY_CONTEXT_START_BIAS=2.2

# Контекстная аффинность ГЛОБАЛЬНЫХ стартов: вес старта умножается на
# affinity^(общие стемы с информативными токенами контекста). Ответы живут
# в стартах, а не в продолжениях вопроса. 1.0 выключает.
CONTEXT_START_AFFINITY=6.0

# Применять контекст только для Telegram reply-сообщений
REPLY_CONTEXT_ONLY_FOR_REPLIES=true

# Добавлять токены текущего сообщения к reply-контексту
REPLY_CONTEXT_INCLUDE_CURRENT_MESSAGE=true

# ----------------------------------------------------------------------------
# Слой «личности» (flavor, эмодзи, мемы, редкие события, причуды)
# ----------------------------------------------------------------------------

# Сила вариатора формы ответа (0..2): вероятностные изменения финальной
# пунктуации (убрать точку / многоточие / "!" / удвоить "?!").
# 0 полностью отключает вариатор.
REPLY_FLAVOR_STRENGTH=1.0

# Эмодзи-канал (M3): шанс добавить в конец ответа эмодзи, взятое из частот
# ЭТОГО чата (в модель слов эмодзи не попадают). 0 отключает канал целиком
# (и обучение частотам эмодзи тоже). После «?» не добавляется; heated усиливает.
EMOJI_APPEND_CHANCE=0.15

# Локальные мемы (L1): вероятность начать самостоятельный (не по упоминанию)
# ответ с «горячей» n-граммы — фразы, которую чат подхватил за последние ~7
# дней. 0 — канал полностью выключен (ни записи, ни чтения).
HOT_NGRAM_SEED_CHANCE=0.25

# Минимум употреблений в окне, чтобы n-грамма могла считаться горячей
# Диапазон 1..1000.
HOT_NGRAM_MIN_COUNT=3

# Горячая = доля оконных употреблений от всех употреблений >= порога (0..1)
HOT_NGRAM_RECENCY_SHARE=0.5

# Редкие события (L3): шанс, что сгенерированный ответ станет «сломом формы» —
# односложный вердикт, КАПС или двойное сообщение. 0 — выключено.
RARE_EVENT_CHANCE=0.03

# Фальстарты (L3): шанс отправить короткий филлер («ну как бы...», «щас»),
# подержать «печатает…» и прислать настоящий ответ вторым сообщением.
# 0 — выключено.
FALSE_START_CHANCE=0.05

# Общий суточный бюджет редких событий и фальстартов на чат
# Диапазон 0..100.
RARE_EVENT_DAILY_CAP=3

# Причуды для завсегдатаев (L2): шанс предварить сгенерированный ответ на
# прямое обращение «постоянного» пользователя коротким вокативом отдельным
# сообщением («опять ты»). 0 — канал полностью выключен (ни записи счётчиков,
# ни чтения). В коде дополнительно зашит кап: не чаще раза в сутки (UTC) на
# пользователя в чате.
USER_QUIRK_CHANCE=0.1

# Сколько отвеченных обращений (с ~30-дневным затуханием) делает пользователя
# «постоянным»
# Диапазон 1..10000 (счётчик затухает, большие пороги недостижимы).
USER_QUIRK_MIN_INTERACTIONS=25

# L2.1: доля сработавших причуд, где вокатив — имя завсегдатая (берётся живьём
# из входящего апдейта, санитизируется; не хранится и не логируется) вместо
# анонимной фразы пула. Имя идёт голым в половине случаев, иначе склеивается с
# фразой пула («саня, опять ты»). 0 — выключено (только пул, прежнее поведение).
USER_QUIRK_NAME_SHARE=0

# ----------------------------------------------------------------------------
# Подача ответа
# ----------------------------------------------------------------------------

# Диапазон задержки перед ответом для эффекта «печатает...».
# TYPING_MAX_MS ограничен 0..15000: пауза дольше читается как зависший бот.
# Заданный здесь максимум по-прежнему главнее встроенного потолка в 4 с.
TYPING_MIN_MS=350
TYPING_MAX_MS=1100

# Добавка к задержке за каждый символ ответа (0..200), чтобы длинные ответы
# «печатались» дольше коротких. Общий потолок задержки — 4 секунды.
# 0 отключает компонент.
TYPING_PER_CHAR_MS=12

# Капитализировать начало предложений в ответе (заглавная в начале и после
# . ! ?). Output-side постобработка, модель не затрагивается. Дефолт false:
# чаты обычно пишут в свободном регистре, и lowercase-ответы выглядят
# естественнее; включайте только если ваш чат пишет формально и после
# offline-проверки (правило «после точки» капитализирует сокращения,
# напр. «т.е.»→«Т.Е.»).
AUTO_CAPITALIZE_REPLIES=false

# ----------------------------------------------------------------------------
# /pivo
# ----------------------------------------------------------------------------

# Секреты для /pivo: HMAC идентификаторов и шифрование данных упоминаний.
# Тот же HMAC-секрет анонимизирует счётчики взаимодействий L2. Требования:
# - два разных значения;
# - минимум 16 символов, лучше 32+;
# - случайная строка без пробелов, например hex/base64/url-safe;
# - не менять после запуска, иначе старые /pivo-подписки (и статус
#   «завсегдатаев» L2) станут недоступны;
# - не коммитить реальные значения в git.
#
# Сгенерировать можно так:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
PIVO_HMAC_SECRET=change_me_to_a_long_random_hmac_secret
PIVO_ENCRYPTION_SECRET=change_me_to_a_long_random_encryption_secret

# Лимиты для /pivo. Работают по-разному, и это намеренно:
# - PIVO_EXPLICIT_MENTIONS_LIMIT — сколько явных @mentions можно указать за
#   вызов. Превышение отклоняет вызов с объяснением: список перечислил сам
#   вызывающий, и молчаливое усечение скрыло бы, что часть людей не позвана.
# - PIVO_SUBSCRIBER_FANOUT_LIMIT — сколько подписчиков зовётся без явных
#   упоминаний. Превышение УСЕКАЕТ список до предела и добавляет в сообщение
#   пометку, что упомянуты не все. Отказ здесь ломал бы команду для всего чата
#   навсегда: достаточно было подписаться сверх предела, и вернуть /pivo мог
#   только `/clear confirm`.
PIVO_EXPLICIT_MENTIONS_LIMIT=10
PIVO_SUBSCRIBER_FANOUT_LIMIT=20

# Анти-повтор шаблонов /pivo (S2): сколько последних индексов top/body/bottom
# помнить на чат и исключать при следующем выборе. 0 отключает анти-повтор.
PIVO_RECENT_POOL_WINDOW=5

# Временны́е модификаторы /pivo (S4): вероятность (0..1) заменить нейтральную
# завершающую строку на тематическую (ночь / пятница / понедельник), когда
# соответствующее время применимо. 0 отключает временны́е вставки.
PIVO_TEMPORAL_FLAVOR_CHANCE=0.5

# Аварийная ручка (O2): как строить упоминание подписчика в /pivo.
# true  — ссылка по user_id (tg://user?id=...) с видимой подписью «@ник»:
#         сервер делает из неё entity text_mention, которая не зависит от
#         сопоставления строки с ником, а сам «@ник» остаётся в тексте.
# false — прежнее поведение: голая строка «@ник».
# Выключать только если ID-путь окажется хуже строкового; штатное значение true.
PIVO_MENTION_BY_ID=true

# Отчёт по упоминаниям в личку владельцу (OWNER_ID) после каждого /pivo:
# название чата, сколько упомянуто по user_id / строкой / пропущено и сколько
# entity text_mention вернул сервер. Тот же агрегат уходит в лог, но логи
# владельцу недоступны — без этого канала наблюдение по O2 провести нечем.
# Отказ доставки (владелец не начинал диалог с ботом) на /pivo не влияет.
PIVO_REPORT_TO_OWNER=true

# ----------------------------------------------------------------------------
# Хранилище и лимиты процесса
# ----------------------------------------------------------------------------

# SQLite хранит только последние N нормализованных сообщений на чат.
# Должно быть не меньше TEXT_CACHE_MAX_MESSAGES.
MESSAGES_RETENTION_PER_CHAT=1000

# Кэш дословных копий держит последние нормализованные сообщения в памяти:
# сгенерированный текст, совпадающий с одним из них 1:1, отбрасывается.
TEXT_CACHE_MAX_MESSAGES=1000

# Ожидание при конкурирующей записи в SQLite и порог автоматического WAL
# checkpoint. 0 страниц — только если checkpoint'ы управляются извне.
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000

# Очистка runtime-состояния долгоживущего процесса: счётчики неактивных чатов
# истекают после RUNTIME_STATE_TTL_SEC, записи троттлинга команд — после
# THROTTLE_STATE_TTL_SEC.
RUNTIME_STATE_TTL_SEC=86400
RUNTIME_STATE_MAX_CHATS=2048
THROTTLE_STATE_TTL_SEC=21600
THROTTLE_STATE_MAX_KEYS=4096
